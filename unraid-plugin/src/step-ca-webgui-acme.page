<div class="step-ca-hidden-shell"></div>

<div class="step-ca-modal-backdrop" id="step-ca-modal-backdrop">
  <div class="step-ca-modal" role="dialog" aria-modal="true" aria-labelledby="step-ca-modal-title">
    <div class="step-ca-modal-header">
      <div class="step-ca-modal-title" id="step-ca-modal-title">Step CA WebGUI ACME Settings</div>
      <button type="button" class="step-ca-close" id="step-ca-close-modal" aria-label="Close">&times;</button>
    </div>

    <form method="POST" id="step-ca-form">
      <table class="step-ca-grid">
        <tr>
          <td>ACME directory URL</td>
          <td>
            <input type="text" name="ACME_DIRECTORY_URL" value="<?= h($config['ACME_DIRECTORY_URL']) ?>">
            <div class="step-ca-note">Default matches this repo's Step CA: <code>https://step-ca.lan:9000/acme/acme/directory</code></div>
          </td>
        </tr>
        <tr>
          <td>Root certificate URL</td>
          <td>
            <input type="text" name="ROOT_CERT_URL" value="<?= h($config['ROOT_CERT_URL']) ?>">
            <div class="step-ca-note">Used to bootstrap trust for the ACME client. For this stack the default is <code>https://step-ca.lan:9000/roots.pem</code>.</div>
          </td>
        </tr>
        <tr>
          <td>ACME account email</td>
          <td>
            <input type="text" name="CONTACT_EMAIL" value="<?= h($config['CONTACT_EMAIL']) ?>">
            <div class="step-ca-note">Optional, but helpful for ACME account registration metadata.</div>
          </td>
        </tr>
        <tr>
          <td>Domain override</td>
          <td>
            <input type="text" name="DOMAIN_OVERRIDE" value="<?= h($config['DOMAIN_OVERRIDE']) ?>">
            <div class="step-ca-note">Leave blank to use <code>[server name].[local TLD]</code> from Unraid. Current preview: <code><?= h($domainPreview) ?></code></div>
          </td>
        </tr>
        <tr>
          <td>Additional domains</td>
          <td>
            <input type="text" name="EXTRA_DOMAINS" value="<?= h($config['EXTRA_DOMAINS']) ?>">
            <div class="step-ca-note">Extra names to include in the certificate, separated by spaces or commas, for example <code>n5-pro.lan</code>. The CA must be able to reach this server at each name for validation. Changing this list triggers a fresh certificate on the next renew.</div>
          </td>
        </tr>
        <tr>
          <td>Server name override</td>
          <td>
            <input type="text" name="SERVER_NAME_OVERRIDE" value="<?= h($config['SERVER_NAME_OVERRIDE']) ?>">
            <div class="step-ca-note">Only needed if the bundle filename should not use the current Unraid server name. Current target bundle: <code><?= h($bundlePath) ?></code></div>
          </td>
        </tr>
        <tr>
          <td>Challenge mode</td>
          <td>
            <select name="CHALLENGE_MODE">
              <option value="standalone" <?= $config['CHALLENGE_MODE'] === 'standalone' ? 'selected' : '' ?>>HTTP-01 standalone on port 80</option>
              <option value="alpn" <?= $config['CHALLENGE_MODE'] === 'alpn' ? 'selected' : '' ?>>TLS-ALPN-01 on port 443</option>
            </select>
            <div class="step-ca-note">Both modes temporarily stop the Unraid WebGUI if you leave that option enabled below.</div>
          </td>
        </tr>
        <tr>
          <td>Allow insecure root bootstrap</td>
          <td>
            <?= yes_no_field('ACME_INSECURE_BOOTSTRAP', $config) ?>
            <div class="step-ca-note">When set to Yes, the plugin uses <code>curl -k</code> only while fetching the initial Step CA root bundle.</div>
          </td>
        </tr>
        <tr>
          <td>Auto renew</td>
          <td>
            <?= yes_no_field('AUTO_RENEW', $config) ?>
            <div class="step-ca-note">Adds a managed root crontab entry that runs the renew action.</div>
          </td>
        </tr>
        <tr>
          <td>Renew cron schedule</td>
          <td>
            <input type="text" name="RENEW_CRON" value="<?= h($config['RENEW_CRON']) ?>">
            <div class="step-ca-note">Standard five-field cron syntax. Default: <code>17 3 * * *</code></div>
          </td>
        </tr>
        <tr>
          <td>Enable SSL after install</td>
          <td>
            <?= yes_no_field('ENABLE_SSL_AFTER_ISSUE', $config) ?>
            <div class="step-ca-note">Runs <code>use_ssl yes</code> after a successful install so Unraid serves the new custom certificate.</div>
          </td>
        </tr>
        <tr>
          <td>Stop WebGUI for challenge</td>
          <td>
            <?= yes_no_field('STOP_WEBSERVER_FOR_CHALLENGE', $config) ?>
            <div class="step-ca-note">Recommended when using standalone or ALPN validation because the ACME client needs port 80 or 443.</div>
          </td>
        </tr>
      </table>

      <div class="step-ca-actions">
        <button type="submit" name="action_save" class="btn">Save</button>
        <button type="submit" name="action_issue" class="btn btn-primary">Save and Issue Cert</button>
        <button type="submit" name="action_renew" class="btn">Save and Renew</button>
        <button type="submit" name="action_status" class="btn">Save and Show Status</button>
      </div>

      <?php foreach ($messages as $message): ?>
        <div class="notice" style="margin-top:16px;"><?= h($message) ?></div>
      <?php endforeach; ?>

      <?php if (trim($output) !== ''): ?>
        <div class="step-ca-result">
          <strong>Command output</strong>
          <pre><?= h(trim($output)) ?></pre>
        </div>
      <?php endif; ?>
    </form>
  </div>
</div>

<div class="step-ca-processing" id="step-ca-processing" aria-live="polite">
  <div class="step-ca-processing-card">
    <div class="step-ca-processing-spinner"></div>
    <div class="step-ca-processing-title">Working...</div>
    <div class="step-ca-processing-text" id="step-ca-processing-text">
      Please wait while the Step CA command finishes. The page will update automatically when the command returns.
    </div>
  </div>
</div>

<script>
  (function () {
    const backdrop = document.getElementById('step-ca-modal-backdrop');
    const closeButton = document.getElementById('step-ca-close-modal');
    const form = document.getElementById('step-ca-form');
    const processing = document.getElementById('step-ca-processing');
    const processingText = document.getElementById('step-ca-processing-text');

    if (!backdrop || !closeButton || !form || !processing || !processingText) {
      return;
    }

    const openModal = () => backdrop.classList.add('is-open');
    const closeModal = () => {
      backdrop.classList.remove('is-open');
      if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location = '/Settings/Utilities';
      }
    };
    const openProcessing = (message) => {
      processingText.textContent = message;
      processing.classList.add('is-open');
    };
    const closeProcessing = () => processing.classList.remove('is-open');

    closeButton.addEventListener('click', closeModal);
    backdrop.addEventListener('click', (event) => {
      if (event.target === backdrop) {
        closeModal();
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeModal();
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const submitter = event.submitter;
      const submitName = submitter && submitter.name ? submitter.name : 'action_save';
      const messages = {
        action_save: 'Saving Step CA settings. Please wait...',
        action_issue: 'Issuing the WebGUI certificate. This can take a little while. Please wait and do not refresh the page...',
        action_renew: 'Renewing the WebGUI certificate. Please wait and do not refresh the page...',
        action_status: 'Loading plugin status. Please wait...'
      };

      const formData = new FormData(form);
      if (submitter && submitter.name) {
        formData.set(submitter.name, submitter.value || '1');
      } else {
        formData.set(submitName, '1');
      }

      openProcessing(messages[submitName] || 'Working. Please wait...');

      Array.from(form.elements).forEach((element) => {
        element.disabled = true;
      });

      try {
        const response = await fetch(window.location.href, {
          method: 'POST',
          body: formData,
          credentials: 'same-origin',
          headers: {
            'X-Requested-With': 'XMLHttpRequest'
          }
        });

        const html = await response.text();
        document.open();
        document.write(html);
        document.close();
      } catch (error) {
        closeProcessing();
        Array.from(form.elements).forEach((element) => {
          element.disabled = false;
        });
        alert('The Step CA command did not complete cleanly. Please try again.');
      }
    });

    openModal();
  })();
</script>
