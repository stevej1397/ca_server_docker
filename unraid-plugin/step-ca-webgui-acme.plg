            <?= yes_no_field('ACME_INSECURE_BOOTSTRAP', $config) ?>
            <div class="step-ca-note">When set to Yes, the plugin uses <code>curl -k</code> only while fetching the initial Step CA root bundle.</div>
          </td>
        </tr>
        <tr>
          <td>Auto renew</td>
          <td>
            <?= yes_no_field('AUTO_RENEW', $config) ?>
            <div class="step-ca-note">Adds a managed root crontab entry that runs the renew action.</div>
          </td>
        </tr>
        <tr>
          <td>Renew cron schedule</td>
          <td>
            <input type="text" name="RENEW_CRON" value="<?= h($config['RENEW_CRON']) ?>">
            <div class="step-ca-note">Standard five-field cron syntax. Default: <code>17 3 * * *</code></div>
          </td>
        </tr>
        <tr>
          <td>Enable SSL after install</td>
          <td>
            <?= yes_no_field('ENABLE_SSL_AFTER_ISSUE', $config) ?>
            <div class="step-ca-note">Runs <code>use_ssl yes</code> after a successful install so Unraid serves the new custom certificate.</div>
          </td>
        </tr>
        <tr>
          <td>Stop WebGUI for challenge</td>
          <td>
            <?= yes_no_field('STOP_WEBSERVER_FOR_CHALLENGE', $config) ?>
            <div class="step-ca-note">Recommended when using standalone or ALPN validation because the ACME client needs port 80 or 443.</div>
          </td>
        </tr>
      </table>

      <div class="step-ca-actions">
        <button type="submit" name="action_save" class="btn">Save</button>
        <button type="submit" name="action_issue" class="btn btn-primary">Save and Issue Cert</button>
        <button type="submit" name="action_renew" class="btn">Save and Renew</button>
        <button type="submit" name="action_status" class="btn">Save and Show Status</button>
      </div>

      <?php foreach ($messages as $message): ?>
        <div class="notice" style="margin-top:16px;"><?= h($message) ?></div>
      <?php endforeach; ?>

      <?php if (trim($output) !== ''): ?>
        <div class="step-ca-result">
          <strong>Command output</strong>
          <pre><?= h(trim($output)) ?></pre>
        </div>
      <?php endif; ?>
