Menu="Utilities"
Type="xmenu"
Icon="icon-key"
Title="Step CA WebGUI ACME"
---
<?php
$plugin = 'step-ca-webgui-acme';
$configDir = "/boot/config/plugins/$plugin";
$configFile = "$configDir/$plugin.cfg";
$stateFile = "$configDir/$plugin.state";
$logFile = "$configDir/logs/issue.log";
$script = "/usr/local/emhttp/plugins/$plugin/scripts/$plugin.sh";
$identFile = '/boot/config/ident.cfg';

$defaults = [
  'ACME_DIRECTORY_URL' => 'https://step-ca.lan:9000/acme/acme/directory',
  'ROOT_CERT_URL' => 'https://step-ca.lan:9000/roots.pem',
  'CONTACT_EMAIL' => '',
  'DOMAIN_OVERRIDE' => '',
  'EXTRA_DOMAINS' => '',
  'SERVER_NAME_OVERRIDE' => '',
  'CHALLENGE_MODE' => 'standalone',
  'ACME_INSECURE_BOOTSTRAP' => 'yes',
  'AUTO_RENEW' => 'yes',
  'RENEW_CRON' => '17 3 * * *',
  'ENABLE_SSL_AFTER_ISSUE' => 'yes',
  'STOP_WEBSERVER_FOR_CHALLENGE' => 'yes',
];

function read_ini_or_defaults($path, array $defaults): array {
  if (!is_file($path)) {
    return $defaults;
  }

  $parsed = parse_ini_file($path, false, INI_SCANNER_RAW);
  if (!is_array($parsed)) {
    return $defaults;
  }

  return array_merge($defaults, $parsed);
}

function write_ini_file(string $path, array $values): void {
  $lines = [];
  foreach ($values as $key => $value) {
    $escaped = addcslashes((string) $value, "\\\"");
    $lines[] = sprintf('%s="%s"', $key, $escaped);
  }

  if (!is_dir(dirname($path))) {
    mkdir(dirname($path), 0700, true);
  }

  file_put_contents($path, implode(PHP_EOL, $lines) . PHP_EOL);
}

function h($value): string {
  return htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
}

function post_value(string $key, array $defaults): string {
  return isset($_POST[$key]) ? trim((string) $_POST[$key]) : (string) ($defaults[$key] ?? '');
}

function yes_no_field(string $name, array $config): string {
  $current = $config[$name] ?? 'no';
  $yes = $current === 'yes' ? 'selected' : '';
  $no = $current === 'no' ? 'selected' : '';
  return "<select name=\"" . h($name) . "\"><option value=\"yes\" $yes>Yes</option><option value=\"no\" $no>No</option></select>";
}

$ident = is_file($identFile) ? (parse_ini_file($identFile, false, INI_SCANNER_RAW) ?: []) : [];
$config = read_ini_or_defaults($configFile, $defaults);
$state = read_ini_or_defaults($stateFile, [
  'LAST_RUN_AT' => '',
  'LAST_RESULT' => '',
  'LAST_MESSAGE' => '',
  'RESOLVED_DOMAIN' => '',
  'TARGET_SERVER_NAME' => '',
  'TARGET_BUNDLE' => '',
  'CERT_NOT_AFTER' => '',
]);

$output = '';
$messages = [];

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
  $config = [
    'ACME_DIRECTORY_URL' => post_value('ACME_DIRECTORY_URL', $defaults),
    'ROOT_CERT_URL' => post_value('ROOT_CERT_URL', $defaults),
    'CONTACT_EMAIL' => post_value('CONTACT_EMAIL', $defaults),
    'DOMAIN_OVERRIDE' => post_value('DOMAIN_OVERRIDE', $defaults),
    'EXTRA_DOMAINS' => post_value('EXTRA_DOMAINS', $defaults),
    'SERVER_NAME_OVERRIDE' => post_value('SERVER_NAME_OVERRIDE', $defaults),
    'CHALLENGE_MODE' => in_array(post_value('CHALLENGE_MODE', $defaults), ['standalone', 'alpn'], true) ? post_value('CHALLENGE_MODE', $defaults) : 'standalone',
    'ACME_INSECURE_BOOTSTRAP' => post_value('ACME_INSECURE_BOOTSTRAP', $defaults) === 'no' ? 'no' : 'yes',
    'AUTO_RENEW' => post_value('AUTO_RENEW', $defaults) === 'no' ? 'no' : 'yes',
    'RENEW_CRON' => post_value('RENEW_CRON', $defaults),
    'ENABLE_SSL_AFTER_ISSUE' => post_value('ENABLE_SSL_AFTER_ISSUE', $defaults) === 'no' ? 'no' : 'yes',
    'STOP_WEBSERVER_FOR_CHALLENGE' => post_value('STOP_WEBSERVER_FOR_CHALLENGE', $defaults) === 'no' ? 'no' : 'yes',
  ];

  write_ini_file($configFile, $config);
  $messages[] = 'Configuration saved.';

  if (is_executable($script)) {
    $configureOutput = shell_exec(escapeshellcmd($script) . ' configure 2>&1');
    if ($configureOutput) {
      $output .= $configureOutput;
    }

    if (isset($_POST['action_issue'])) {
      $output .= shell_exec(escapeshellcmd($script) . ' issue 2>&1');
    } elseif (isset($_POST['action_renew'])) {
      $output .= shell_exec(escapeshellcmd($script) . ' renew 2>&1');
    } elseif (isset($_POST['action_status'])) {
      $output .= shell_exec(escapeshellcmd($script) . ' status 2>&1');
    }
  } else {
    $messages[] = "Helper script not found at $script";
  }

  $state = read_ini_or_defaults($stateFile, $state);
}

$serverName = trim($config['SERVER_NAME_OVERRIDE']) !== '' ? trim($config['SERVER_NAME_OVERRIDE']) : ($ident['NAME'] ?? '');
$localTld = trim((string) ($ident['LOCAL_TLD'] ?? ''));
$domainPreview = trim($config['DOMAIN_OVERRIDE']) !== '' ? trim($config['DOMAIN_OVERRIDE']) : (($serverName !== '' && $localTld !== '') ? $serverName . '.' . $localTld : '(configure Local TLD in Unraid or set Domain override)');
$bundleServer = $serverName !== '' ? $serverName : ($state['TARGET_SERVER_NAME'] ?: explode('.', $domainPreview)[0]);
$bundleServer = preg_replace('/[^A-Za-z0-9._-]+/', '-', (string) $bundleServer);
$bundlePath = "/boot/config/ssl/certs/{$bundleServer}_unraid_bundle.pem";
?>

<style>
