    padding: 24px;
  }

  .step-ca-processing.is-open {
    display: flex;
  }

  .step-ca-processing-card {
    width: min(520px, 100%);
    background: var(--step-ca-surface);
    color: var(--step-ca-text);
    border: 1px solid var(--step-ca-border);
    border-radius: 12px;
    box-shadow: var(--step-ca-shadow);
    padding: 22px 24px;
